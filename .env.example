# Aplicação
# APP_USER/APP_PASSWORD criam o primeiro administrador no primeiro boot. Depois, senhas são geridas no sistema.
APP_NAME=Plataforma Gestão Integrada
APP_USER=admin
APP_PASSWORD=troque-esta-senha
# IMPORTANTE: preserve a mesma SECRET_KEY entre versões/deploys. Ela protege sessão e credenciais das integrações.
SECRET_KEY=troque-por-uma-chave-grande-e-estavel
# Opcional: chave separada só para criptografia das integrações. Se vazia, usa SECRET_KEY.
INTEGRATION_SECRET_KEY=

# Persistência
# Local/Windows: deixe DATA_DIR vazio para usar uma pasta persistente fora do ZIP/versão.
# Railway com SQLite + Volume: defina DATA_DIR=/data.
DATA_DIR=
# Produção recomendada: PostgreSQL do Railway. Use a DATABASE_URL fornecida pelo serviço.
DATABASE_URL=

# As credenciais abaixo são apenas FALLBACK. Após iniciar, prefira gravá-las na tela Integrações.
# ERPFlex - somente leitura
ERPFLEX_API_BASE=https://api.erpflex.com.br
ERPFLEX_USER=
ERPFLEX_PASS=

# NF Stock / Alterdata - somente leitura
NFSTOCK_BASE_URL=https://ms-exportacao-nfstock.pack.alterdata.com.br
NFSTOCK_TOKEN=
NFSTOCK_CRM=
COMPANY_CNPJ=
NFSTOCK_PAGE_SIZE=25

# Motor de integração ERPFlex. go_v78 usa o mesmo stack HTTP do Analytics V7.8.
ERPFLEX_ENGINE=go_v78

# SMTP - envio de boletos (fallback; prefira configurar na tela Integrações)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Financeiro
SMTP_SECURITY=starttls

# Worker de sincronização automática
# Fuso usado somente para a janela de horário configurada na Central de Sincronização.
APP_TIMEZONE=America/Sao_Paulo
# Nome lógico opcional da instância do worker.
SYNC_WORKER_NAME=sync-worker
